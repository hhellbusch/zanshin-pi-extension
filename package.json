{
  "name": "zanshin-pi-extension",
  "version": "0.3.0",
  "description": "Zanshin L0 for Pi (always-on system prompt) plus bundled kit markdown under kit/ (WORKING-STYLE, STYLE, template).",
  "keywords": [
    "pi-package",
    "pi-extension",
    "extension",
    "pi",
    "zanshin"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhellbusch/zanshin-pi-extension.git"
  },
  "homepage": "https://github.com/hhellbusch/zanshin-pi-extension#readme",
  "bugs": {
    "url": "https://github.com/hhellbusch/zanshin-pi-extension/issues"
  },
  "files": [
    "extensions",
    "lib",
    "kit",
    "skills",
    "plugin.json",
    ".codex-plugin",
    ".cursor-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "surface": "node scripts/check-kit-surface.mjs",
    "planning": "node --experimental-strip-types --test scripts/resume-contract.test.ts",
    "validate": "node scripts/validate-extensions.mjs",
    "test:core": "npm run surface && npm run planning",
    "test:offline": "npm run test:core",
    "test:pi": "npm run check && npm run validate",
    "test": "npm run test:core && npm run test:pi"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
